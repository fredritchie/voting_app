        <mxCell id="hcpRole" value="&lt;b&gt;hcp-terraform-voting-app-v2&lt;/b&gt;&lt;br&gt;VPC / EKS / ECR / RDS / Logs&lt;br&gt;scoped IAM role management&lt;br&gt;dashboard + Pod Identity pass-role" style="shape=mxgraph.aws4.identity_and_access_management;fillColor=#DD344C;strokeColor=none;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=10;fontColor=#232F3E;" vertex="1" parent="identity"><mxGeometry x="350" y="235" width="78" height="78" as="geometry"/></mxCell>
