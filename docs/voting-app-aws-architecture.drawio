        <mxCell id="pe2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E7D32;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="pipeline" source="quality" target="remotePlan"><mxGeometry relative="1" as="geometry"/></mxCell>
