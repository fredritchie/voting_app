        <mxCell id="identity" value="FEDERATED IDENTITY — AWS IAM" style="swimlane;html=1;rounded=1;startSize=34;horizontal=1;fillColor=#FFF0F3;swimlaneFillColor=#FFFFFF;strokeColor=#DD344C;fontStyle=1;fontColor=#A40E26;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1070" y="110" width="530" height="440" as="geometry"/></mxCell>
