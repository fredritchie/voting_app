        <mxCell id="oSub" value="No long-lived AWS keys • immutable releases • remote Terraform execution • centralized CloudWatch telemetry" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=14;fontColor=#5F6B7A;" vertex="1" parent="1"><mxGeometry x="42" y="63" width="1000" height="28" as="geometry"/></mxCell>
        <mxCell id="pipeline" value="DELIVERY PIPELINE" style="swimlane;html=1;rounded=1;startSize=34;horizontal=1;fillColor=#F0F7FF;swimlaneFillColor=#FFFFFF;strokeColor=#54AEFF;fontStyle=1;fontColor=#0969DA;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1000" height="440" as="geometry"/></mxCell>
        <mxCell id="commit" value="&lt;b&gt;1 • Commit / PR&lt;/b&gt;&lt;br&gt;feature → develop → main" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#24292F;strokeColor=#57606A;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="pipeline"><mxGeometry x="30" y="65" width="150" height="75" as="geometry"/></mxCell>
        <mxCell id="quality" value="&lt;b&gt;2 • Quality gates&lt;/b&gt;&lt;br&gt;Python unittest&lt;br&gt;Node npm test&lt;br&gt;.NET test&lt;br&gt;Terraform fmt/validate&lt;br&gt;Kustomize + Docker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF4FF;strokeColor=#54AEFF;fontColor=#0550AE;fontSize=11;" vertex="1" parent="pipeline"><mxGeometry x="215" y="45" width="170" height="120" as="geometry"/></mxCell>
        <mxCell id="remotePlan" value="&lt;b&gt;3 • HCP remote plan&lt;/b&gt;&lt;br&gt;state lock&lt;br&gt;dynamic AWS OIDC&lt;br&gt;detailed exit code&lt;br&gt;0 = skip apply&lt;br&gt;2 = apply plan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEE5FF;strokeColor=#8250DF;fontColor=#3B1E70;fontSize=11;" vertex="1" parent="pipeline"><mxGeometry x="420" y="45" width="170" height="120" as="geometry"/></mxCell>
        <mxCell id="build" value="&lt;b&gt;4 • Build + publish&lt;/b&gt;&lt;br&gt;vote / result / worker&lt;br&gt;tag = Git commit SHA&lt;br&gt;skip existing ECR image" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1E5;strokeColor=#FF9900;fontColor=#8A4B08;fontSize=11;" vertex="1" parent="pipeline"><mxGeometry x="625" y="45" width="170" height="120" as="geometry"/></mxCell>
        <mxCell id="release" value="&lt;b&gt;5 • Kustomize release&lt;/b&gt;&lt;br&gt;develop → staging ×1&lt;br&gt;main → production ×3&lt;br&gt;production approval gate&lt;br&gt;rollout status checks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAFBE1;strokeColor=#2DA44E;fontColor=#116329;fontSize=11;" vertex="1" parent="pipeline"><mxGeometry x="830" y="45" width="145" height="120" as="geometry"/></mxCell>
        <mxCell id="artifact" value="&lt;b&gt;Release invariant&lt;/b&gt;&lt;br&gt;The exact tested commit SHA identifies all three images and the Kubernetes deployment annotation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8C5;strokeColor=#D4A72C;fontColor=#633C01;fontSize=11;" vertex="1" parent="pipeline"><mxGeometry x="250" y="240" width="500" height="75" as="geometry"/></mxCell>
