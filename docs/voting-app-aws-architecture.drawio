        <mxCell id="ghRole" value="&lt;b&gt;github-actions-voting-app&lt;/b&gt;&lt;br&gt;ECR push • EKS DescribeCluster&lt;br&gt;EKS access entry / cluster policy&lt;br&gt;subjects: staging + production" style="shape=mxgraph.aws4.identity_and_access_management;fillColor=#DD344C;strokeColor=none;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=10;fontColor=#232F3E;" vertex="1" parent="identity"><mxGeometry x="350" y="65" width="78" height="78" as="geometry"/></mxCell>
